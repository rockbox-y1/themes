# Theme: bunnyPod
# Version 1.0 (360p Scaled)
# Last Update: 02/23/2026
# License: CC-BY-SA 3.0
# By: Monica G.
# Description: Cute bunny theme :3 featuring LanaPixel font by eishiya

# SBS File

# Disable Status Bar
%wd

# Disable Title
%?Lt<|>

# Preload Fonts
%Fl(2,14-LanaPixel.fnt)
%Fl(3,62-LanaPixel.fnt)
%Fl(4,21-LanaPixel.fnt)


#Preload Images
%xl(bunny_sbs,bunny_sbs.bmp,0,0)
%xl(bunny_usb,bunny_usb.bmp,0,0)
%xl(music_note,music_note.bmp,0,0)
%xl(playmodes,playmodes.bmp,0,0,9)
%xl(repeat,repeat_status.bmp,0,0,5)
%xl(shuffle,shuffle.bmp,0,0,2)
%xl(battery,battery.bmp,0,0,12)
%xl(disk,disk.bmp,0,0)
%xl(lock,lock.bmp,0,0,2)
%xl(corner,corner.bmp,0,0,4)

# Display Viewports
%?if(%cs, =, 21)<%VI(clearScreen)%Vd(usbScreen)%Vd(border)|%Vd(mainMenu)<%VI(mainMenu)%Vd(mainMenu)%Vd(border)>>

# Clear Screen
%Vi(clearScreen,0,0,1,1,-)

## Main Menu ##

# Main Menu UI Viewport
%Vi(mainMenu,15,75,315,260,3)

# Bunny SBS
%Vl(mainMenu,336,157,144,203,-)
%xd(bunny_sbs)

# Rounded corners
%Vl(border,0,0,9,9,-)
%xd(corner,1)
%Vl(border,471,0,9,9,-)
%xd(corner,2)
%Vl(border,0,351,9,9,-)
%xd(corner,3)
%Vl(border,471,351,9,9,-)
%xd(corner,4)

# Line
%Vl(mainMenu,8,54,465,3,-)
%dr(0,0,465,1)

# Play/Pause Icons
%Vl(mainMenu,15,11,33,33,-)
%?if(%mp, >, 1)<%xd(playmodes,%mp)>

# Shuffle Icon
%Vl(mainMenu,54,11,38,33,-)
%?if(%mp, >, 1)<%?ps<%xd(shuffle,1)|%xd(shuffle,2)>|>

# Repeat Icon
%Vl(mainMenu,104,11,38,33,-)
%?if(%mp, >, 1)<%?mm<%xd(repeat,5)|%xd(repeat,1)|%xd(repeat,2)|%xd(repeat,3)|%xd(repeat,4)>|>

# Hold / Device
%Vl(mainMenu,173,6,150,45,3)
%?mh<%acHOLD|>

# Battery Icon
%Vl(mainMenu,390,9,81,35,2)
%?bp<%xd(battery,7)|%?bl<%xd(battery,6)|%xd(battery,5)|%xd(battery,4)|%xd(battery,3)|%xd(battery,2)|%xd(battery,1)>>%?bp<%?bc<%?bl<%xd(battery,12)|%xd(battery,11)|%xd(battery,10)|%xd(battery,9)|%xd(battery,8)|%xd(battery,7)>|%?bl<%xd(battery,6)|%xd(battery,5)|%xd(battery,4)|%xd(battery,3)|%xd(battery,2)|%xd(battery,1)>>>

# Time
%Vl(mainMenu,345,65,128,40,4)
%ac%?cf<%cH|%cl>:%cM%?cf<| %cP>

# Date
%Vl(mainMenu,345,120,128,23,2)
%ac%?cu<Mon|Tues|Wed|Thurs|Fri|Sat|Sun>, %cb %cd

# Disk
%Vl(mainMenu,321,14,29,27,-)
%?lh<%t(0.5)%xd(disk,1);%t(0.5)|>

# Hold
%Vl(mainMenu,356,11,30,30,-)
%?mh<%xd(lock,2)|%xd(lock,1)>

# Mini Album Art
%Vl(mainMenu,15,334,24,24,-)
%Cl(2,2,21,21,c,c)
%?if(%mp, >, 1)<%?C<%Cd|%xd(music_note)>|>
%?if(%mp, >, 1)<%?C<%dr(0,0,24,2)>|>
%?if(%mp, >, 1)<%?C<%dr(0,23,24,2)>|>
%?if(%mp, >, 1)<%?C<%dr(0,2,2,21)>|>
%?if(%mp, >, 1)<%?C<%dr(23,2,2,21)>|>

# Now Playing
%Vl(mainMenu,45,334,291,23,2)
%al%s%ia - %it

## Quick Screen ##

# Clear Screen
%?if(%cs, =, 10)<%Vd(QuickScreen)%VI(QuickScreen)>

# Quick Screen Viewport
%Vi(QuickScreen,15,60,300,267,2)

## USB Screen ##

# USB Screen Viewport
%Vl(usbScreen,0,0,480,360,-)

%Vl(usbScreen,165,150,158,192,-)
%xd(bunny_usb)

# Time / Battery (numerical)
%Vl(usbScreen,15,8,360,38,3)
%al%?cf<%cH|%cl>:%cM%?cf<| %cP>

# Battery Icon
%Vl(usbScreen,390,11,81,35,2)
%?bp<%xd(battery,7)|%?bl<%xd(battery,6)|%xd(battery,5)|%xd(battery,4)|%xd(battery,3)|%xd(battery,2)|%xd(battery,1)>>%?bp<%?bc<%?bl<%xd(battery,12)|%xd(battery,11)|%xd(battery,10)|%xd(battery,9)|%xd(battery,8)|%xd(battery,7)>|%?bl<%xd(battery,6)|%xd(battery,5)|%xd(battery,4)|%xd(battery,3)|%xd(battery,2)|%xd(battery,1)>>>

# Line
%Vl(usbScreen,8,54,465,3,-)
%dr(0,0,465,3)

# USB Text
%Vl(usbScreen,90,75,300,41,3)
%acUSB CONNECTED%Vs(invert)

# Eject Warning
%Vl(usbScreen,90,120,300,27,2)
%ac%t(1)! EJECT BEFORE DISCONNECTING !;%t(.1)%ac

# Battery (numerical
%Vl(usbScreen,323,225,75,27,2)