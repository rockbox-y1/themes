
# Theme: MOTHERBOARD
# Version 2.0
# Updates: Fixed 24hr time position and hold icon. Slightly repositioned play status/repeat/shuffle icons
# Last Update: 02/12/2026
# License: CC-BY-SA 3.0
# By: Monica G.
# By: rockbox-y1 (360p conversion)
# Description: Pixel Art of the iPod 5th gen motherboard! Changing the background color changes some elements in the WPS, but kept all other menus/screens grey-scale.
# Using element from Pixel Computer by me! Code based on OneBit_OLED by Jihoon Kim and SNARTY by Simon Anden!
# Icons/elements from Pixel Computer, originally altered from OneBit_OLED by Jihoon Kim and SNARTY by Simon Anden!

# Disable Status Bar
%wd

# Backdrop Image
%xl(MOTHERBOARD,MOTHERBOARD_WPS.bmp,0,0)

# Clear Backdrop
%V(0,0,-,-,-)%VB
%xd(MOTHERBOARD)
%V(0,0,-,-,-)

# Preload Fonts
%Fl(2,18-Terminus.fnt)
%Fl(3,20-Terminus.fnt)
%Fl(4,28-Terminus-Bold.fnt)

# Preload Images
%xl(battery,battery.bmp,0,0,12)
%xl(playmodes_wps,playmodes_wps.bmp,0,0,9)
%xl(vb_back,vb_back.bmp,0,0)
%xl(vb,vb.bmp,0,0)
%xl(pb_back,pb_back.bmp,0,0)
%xl(pb,pb.bmp,0,0)
%xl(R,repeat_status_wps.bmp,0,0,5)
%xl(S,shuffle_wps.bmp,0,0,2)
%xl(lock,lock.bmp,0,0,2)
%xl(X,seeking_icon.bmp,0,0,2)
%xl(slider,slider.bmp,0,0)
%xl(L,lossless.bmp,0,0)

# Album Art
%Cl(0,0,138,138,c,c)
%?and(%C,%if(%St(volume display), =, graphic))<%Vd(albumArt)>
%Vl(albumArt,335,150,138,138,-)
%Cd


## Icons ##

#Hold Status
%V(11,12,18,24,-)
%?mh<%xd(lock,1)|%xd(lock,2)>
%V(386,45,90,20,2)%Vf(ffffff)
%?mh<%ac--LOCKED--|>

# Storage Access
%V(27,5,18,18,-)
%?lh<%t(0.1)%xd(X,1);%t(0.1)%xd(X,2)|>

# Playback Icons
%V(23,206,37,37,-)
%?if(%mp, >, 1)<%xd(playmodes_wps,%mp)|>

# Repeat Icon
%V(24,251,38,37,-)
%?mm<%xd(R,1)|%xd(R,2)|%xd(R,3)|%xd(R,4)|%xd(R,5)>

# Shuffle Icon
%V(68,251,37,37,-)
%?ps<%xd(S,2)|%xd(S,1)>

# Battery viewport selector (flash when low, animates when charging)
%?bc<%Vd(battCharging)|%?if(%bl,>=,15)<%Vd(batt)|%Vd(lowBatt)>>

# Battery (graphical)
%Vl(batt,437,20,34,15,-)
%Vf(-)
%?bl<%xd(battery,1)|%xd(battery,2)|%xd(battery,3)|%xd(battery,4)|%xd(battery,5)|%xd(battery,6)|%xd(battery,7)|%xd(battery,8)|%xd(battery,9)|%xd(battery,10)|%xd(battery,11)>

%Vl(lowBatt,437,20,34,15,-)
%Vf(-)
%t(1)%?if(%bl,>=,10)<%xd(battery,2)|%xd(battery,1)>;%t(1)%xd(battery,12)

%Vl(battCharging,437,20,34,15,-)
%Vf(-)
%t(0.1)%?bl<%xd(battery,1)|%xd(battery,2)|%xd(battery,3)|%xd(battery,4)|%xd(battery,5)|%xd(battery,6)|%xd(battery,7)|%xd(battery,8)|%xd(battery,9)|%xd(battery,10)|%xd(battery,11)>;%t(0.1)%?bl<%xd(battery,4)|%xd(battery,5)|%xd(battery,6)|%xd(battery,7)|%xd(battery,8)|%xd(battery,9)|%xd(battery,10)|%xd(battery,11)>;%t(0.1)%?bl<%xd(battery,8)|%xd(battery,9)|%xd(battery,10)|%xd(battery,11)>;%t(1)%xd(battery,11)

# Clock
%V(150,0,210,20,2)%Vf(ffffff)
%ac%?cf<%cH|%cl>:%cM%?cf<| %cP>

# Battery (numerical)
%V(380,18,40,20,2)%Vf(ffffff)
%ar%bl%%

# Volume Level Text
%V(405,110,69,19,2)%Vf(ffffff)
%ar%?if(%pv, >, 0)<+|>%pvdB

%V(381,110,53,19,2)%Vf(ffffff)
%alVOL

#__Volume Bar
%V(374,90,105,18,-)
%pv(0,0,105,18,vb,pc_wps,vb_back)

# Progress Bar
%V(53,351,375,5,0)
%pb(0,0,375,5,pb,pc_wps,pb_back)

# Song Current Time
%V(3,342,48,18,2)%Vf(ffffff)
%ac%pc

# Song Remaining Time
%V(426,342,48,18,2)%Vf(ffffff)
%ac%pr

## Content ##

# Song Title
%V(53,83,267,45,4)%Vf(ffffff)
%al%s%?it<%s%it|%fn>

# Album
%V(53,53,267,27,3)%Vf(ffffff)
%al%s%?id<%id|Unknown Album>

# Artist
%V(53,119,267,27,3)%Vf(ffffff)
%al%s%?ia<%ia>

# Track Details
%V(53,147,262,23,2)%Vf(ffffff)%Vb(000000)
%al%?fc<MP1|MP2|MP3|AIFF|WAV|VORBIS|FLAC|MPC|AC3|WAVPACK|ALAC|AAC|SHORTEN|SID|ADX|NSF|SPEEX|SPC|APE|WMA|WMAPRO|MOD|SAP|COOK|AAC|AC3|ATRAC3|CMC|CM3|CMR|CMS|DMC|DLT|MPT|MPD|RMT|TMC|TM8|TM2|ATRAC3|SMAF|AU|VOX|WAVE64|TRUEAUDIO|WMAVOICE|MUSEPACK|AAC-HE|AY|VTX|GBS|HES|SGC|VGM|KSS|OPUS|AAC|UNKNOWN?> %?fv<~>%fbkbps%?iy< // %iy>

%?or(%if(%fc, =, 4),%if(%fc, =, 5),%if(%fc, =, 7),%if(%fc, =, 11),%if(%fc, =, 13))<%Vd(lossless)>
%Vl(lossless,72,179,102,24,-)
%xd(L)

# Playlist Number
%V(368,311,112,18,2)%Vf(ffffff)
%?if(%pp, =, %pe)<%pp %Sx(of) %pe|%ar%s%pp %Sx(of) %pe|%ac%s%pp %Sx(of) %pe|%ar%s%pp %Sx(of) %pe|%ar%s%pp %Sx(of) %pe>

# Next track
%V(230,191,93,22,2)%Vf(808080)
%ar%?It<%Sx(Next Track:)|%Fn>
%V(71,210,249,23,2)%Vf(808080)
%s%ar%?It<%It|%Fn>
%V(126,230,192,22,2)%Vf(808080)
%s%ar%?Ia<%Ia>