# Theme: crowPod
# Version 1.0
# Last Update: 06/25/2026
# License: CC-BY-SA 3.0
# By: Monica G.
# By: rockbox-y1 (360p conversion)
# Description: Crow theme!! All pixel art is by me. The picture on the menu changes according to the time of day (changes at 8 AM, 2 PM, and 6 PM). 
# Code based on: bunnyPod by me! which are based on SNARTY by Simon Anden and BONES by Chuck Largo! Credits to J. Adler for ProFont-CJK. Other fonts used are Bitstream Cyberbit and LanaPixel by eishiya. Also inspired by RatPod by Jannis Bolzern! 
# Caw caw!

## WPS File ##

#Hide The Status Bar
%wd

# Preload Backdrop #
%xl(background,background.bmp,0,0)

# Clear Backdrop
%V(0,0,-,-,-)%VB
%xd(background)
%V(0,0,-,-,-)

# Preload Fonts
%Fl(6,11-lanapixel.fnt)
%Fl(7,25-profont-29px-square.fnt)
%Fl(9,35-FreeSerif.fnt)

# Preload Images
%xl(playmodes,playmodes.bmp,0,0,9)
%xl(repeat,repeat_status.bmp,0,0,5)
%xl(shuffle,shuffle.bmp,0,0,2)
%xl(battery,battery.bmp,0,0,12)
%xl(PB,pb.bmp,0,0)
%xl(PBB,pb_back.bmp,0,0)
%xl(VB,vb.bmp,0,0)
%xl(VBB,vb_back.bmp,0,0)
%xl(crow_album,crow_album.bmp,2,2)
%xl(disk,disk.bmp,0,0,5)
%xl(PS,ps.bmp,0,0)

## Main Display ##
%Vd(mainDisplay)

# Clear Screen
%Vl(mainDisplay,0,0,480,360,-)

# Hold
%Vl(mainDisplay,330,18,60,23,6)
%ac%?mh<HOLD%Vs(invert)|>

# Battery Icon
%Vl(mainDisplay,398,15,33,27,-)
%?bp<%xd(battery,7)|%?bl<%xd(battery,6)|%xd(battery,5)|%xd(battery,4)|%xd(battery,3)|%xd(battery,2)|%xd(battery,1)>>%?bp<%?bc<%?bl<%xd(battery,12)|%xd(battery,11)|%xd(battery,10)|%xd(battery,9)|%xd(battery,8)|%xd(battery,7)>|%?bl<%xd(battery,6)|%xd(battery,5)|%xd(battery,4)|%xd(battery,3)|%xd(battery,2)|%xd(battery,1)>>>

# Disk
%Vl(mainDisplay,435,15,30,30,-)
%?lh<%t(0.1)%xd(disk,5);%t(0.1)%xd(disk,1);%t(0.1)%xd(disk,2);%t(0.1)%xd(disk,3);%t(0.1)%xd(disk,4)|%xd(disk,5)>

# Line
%Vl(mainDisplay,150,54,330,2,-)
%dr(0,0,330,2)

# Playlist Number
%Vl(mainDisplay,120,336,210,18,6)
%ac%pp / %pe

# Play/Pause Icons
%Vl(mainDisplay,165,11,33,33,-)
%?if(%mp, >, 1)<%xd(playmodes,%mp)|>

# Shuffle Icon
%Vl(mainDisplay,207,9,38,33,-)
%?ps<%xd(shuffle,1)|%xd(shuffle,2)>

# Repeat Icon
%Vl(mainDisplay,255,11,39,33,-)
%?mm<%xd(repeat,5)|%xd(repeat,1)|%xd(repeat,2)|%xd(repeat,3)|%xd(repeat,4)>

# Volume Bar
%Vl(mainDisplay,128,90,345,9,-)
%pv(0,0,345,9,VBB,backdrop,VB)

# Volume Text
%Vl(mainDisplay,375,99,90,18,6)
%arVOL: %pvdb

# Track Progress Bar
%Vl(mainDisplay,12,317,402,16,-)%Vf(-)%Vb(-)
%pb(0,0,-,16,PBB,backdrop,PB,slider,PS)

# Time Elapsed
%Vl(mainDisplay,30,336,75,18,6)
%al%pc

# Time Remaining
%Vl(mainDisplay,345,336,75,18,6)
%ar-%pr

# Play Screen Album Art
%Vl(mainDisplay,8,110,183,183,-)
%Cl(1,1,180,180,c,c)
%?C<%Cd|%xd(crow_album)>
%dr(0,0,183,1)
%dr(0,181,183,2)
%dr(0,1,1,180)
%dr(181,1,2,180)

# Track Title
%Vl(mainDisplay,203,132,270,38,9)
%al%s%?it<%s%it|%fn>

# Artist
%Vl(mainDisplay,203,177,270,27,7)
%al%s%?ia<%ia>

# Album
%Vl(mainDisplay,203,207,270,27,7)
%al%s%?id<%id>

# File Info
%Vl(mainDisplay,150,60,315,23,6)
%alYear: %?it<%?iy<%ss(0,4,%iy)|????>|> %ar%fc | %fb kbps | %fk kHz