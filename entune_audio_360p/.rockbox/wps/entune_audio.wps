# Theme: entune_audio
# Version 1.0
# Last Update: 05/29/2026
# License: CC-BY-SA 3.0
# By: Monica G.
# By: rockbox-y1 (360p conversion)
# Description: Theme based on the Entune Audio media system. Fonts are the SF-Pro fonts, all pixel art is by me. All icons are made by me and/or updated from my previous themes. (minimal_RTC_sync and bunnyPod).
# The San Francisco font is owned by Apple Inc. and this theme does not claim any ownership over the font.
# Code based on: minimal_RTC_sync and bunnyPod which were based on SNARTY by Simon Anden and BONES by Chuck Largo!

## WPS File ##

#Hide The Status Bar
%wd

# Preload Backdrop #
%xl(etune_wps,etune_wps.bmp,0,0)

# Clear Backdrop
%V(0,0,-,-,-)%VB
%xd(etune_wps)
%V(0,0,-,-,-)

# Preload Fonts
%Fl(2,21-SF-Pro.fnt)
%Fl(3,24-SF-Pro.fnt)
%Fl(4,30-SF-Pro.fnt)

# Preload Images
%xl(playmodes,playmodes.bmp,0,0,9)
%xl(repeat,repeat_status.bmp,0,0,5)
%xl(shuffle,shuffle.bmp,0,0,2)
%xl(battery,battery.bmp,0,0,12)
%xl(PB,pb.bmp,0,0)
%xl(PBB,pb_back.bmp,0,0)
%xl(VB,vb.bmp,0,0)
%xl(VBB,vb_back.bmp,0,0)
%xl(disk,disk.bmp,0,0,5)
%xl(lock,lock.bmp,0,0,2)

# Main Display
%Vd(mainDisplay)

# Clear Screen
%Vl(mainDisplay,0,0,480,360,-)

## Album Art ##
%Vl(mainDisplay,9,51,150,150,-)
%Cl(0,0,149,149)
%?C<%Cd>

## Main Display ##

# Disk
%Vl(mainDisplay,324,11,24,24,-)
%?lh<%t(0.1)%xd(disk,5);%t(0.1)%xd(disk,1);%t(0.1)%xd(disk,2);%t(0.1)%xd(disk,3);%t(0.1)%xd(disk,4)|%xd(disk,5)>

# Hold Icon
%Vl(mainDisplay,398,9,75,27,-)
%?mh<%xd(lock,1)|%xd(lock,2)>

# Battery Icon
%Vl(mainDisplay,353,9,33,27,-)
%?bp<%xd(battery,7)|%?bl<%xd(battery,6)|%xd(battery,5)|%xd(battery,4)|%xd(battery,3)|%xd(battery,2)|%xd(battery,1)>>%?bp<%?bc<%?bl<%xd(battery,12)|%xd(battery,11)|%xd(battery,10)|%xd(battery,9)|%xd(battery,8)|%xd(battery,7)>|%?bl<%xd(battery,6)|%xd(battery,5)|%xd(battery,4)|%xd(battery,3)|%xd(battery,2)|%xd(battery,1)>>>

# Playlist Number
%Vl(mainDisplay,203,201,262,24,2)
%acTrack %pp of %pe

# Shuffle Icon
%Vl(mainDisplay,168,326,75,27,-)
%?ps<%xd(shuffle,1)|%xd(shuffle,2)>

# Repeat Icon
%Vl(mainDisplay,245,326,75,27,-)
%?mm<%xd(repeat,5)|%xd(repeat,1)|%xd(repeat,2)|%xd(repeat,3)|%xd(repeat,4)>|>

# Play/Pause Icons
%Vl(mainDisplay,321,326,75,27,-)
%?if(%mp, >, 1)<%xd(playmodes,%mp)|>

# Volume Level
%Vl(mainDisplay,417,327,54,24,2)
%al%?if(%pv, >, 0)<+|>%pvdB

# Volume Bar
%Vl(mainDisplay,128,8,180,27,-)
%?mv<%pv(0,0,180,27,VBB,backdrop,VB)|>

# Time
%Vl(mainDisplay,8,9,105,30,4)
%al%?cf<%cH|%cl>:%cM%?cf<| %cP>

# File Details
%Vl(mainDisplay,9,210,147,24,2)
%ar%?it<%?iy<%ss(0,4,%iy)>|>
%Vl(mainDisplay,9,234,147,24,2)
%ar%fc
%Vl(mainDisplay,9,258,147,24,2)
%ar%fb kbps
%Vl(mainDisplay,9,282,147,24,2)
%ar%fk kHz

# Track Progress Bar
%Vl(mainDisplay,173,293,295,13,-)%Vf(-)%Vb(-)
%pb(0,0,-,13,PBB,backdrop,PB)

# Time Elapsed
%Vl(mainDisplay,173,270,75,24,2)
%al%pc

# Time Remaining
%Vl(mainDisplay,392,270,75,24,2)
%ar-%pr

## Track info ##

# Artist
%Vl(mainDisplay,203,63,262,24,3)
%ac%s%?ia<%ia>

# Track Title
%Vl(mainDisplay,203,110,262,24,3)
%ac%s%?it<%s%it|%fn>

# Album
%Vl(mainDisplay,203,158,262,24,3)
%ac%s%?id<%id>
