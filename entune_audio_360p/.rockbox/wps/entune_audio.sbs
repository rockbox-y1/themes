# Theme: entune_audio
# Version 1.0
# Last Update: 05/29/2026
# License: CC-BY-SA 3.0
# By: Monica G.
# By: rockbox-y1 (360p conversion)
# Description: Theme based on the Entune Audio media system. Fonts are the SF-Pro fonts, all pixel art is by me. All icons are made by me and/or updated from my previous themes. (minimal_RTC_sync and bunnyPod).
# The San Francisco font is owned by Apple Inc. and this theme does not claim any ownership over the font.
# Code based on: minimal_RTC_sync and bunnyPod which were based on SNARTY by Simon Anden and BONES by Chuck Largo!

# SBS File

# Disable Status Bar
%wd

# Disable Title
%?Lt<|>

# Preload Fonts
%Fl(3,24-SF-Pro.fnt)
%Fl(4,30-SF-Pro.fnt)

#Preload Images
%xl(music_note,music_note.bmp,0,0)
%xl(playmodes,playmodes.bmp,0,0,9)
%xl(repeat,repeat_status.bmp,0,0,5)
%xl(shuffle,shuffle.bmp,0,0,2)
%xl(battery,battery.bmp,0,0,12)
%xl(disk,disk.bmp,0,0,5)
%xl(lock,lock.bmp,0,0,2)
%xl(usb,usb.bmp,0,0)

# Display Viewports
%?if(%cs, =, 21)<%VI(clearScreen)%Vd(usbScreen)%Vd(border)|%Vd(mainMenu)<%VI(mainMenu)%Vd(mainMenu)%Vd(border)>>

# Clear Screen
%Vi(clearScreen,0,0,2,2,-)

## Main Menu ##

# Main Menu UI Viewport
%Vi(mainMenu,15,90,450,240,4)

# Line
%Vl(mainMenu,8,45,465,3,-)
%dr(0,0,465,3)

# Play/Pause Icons
%Vl(mainMenu,15,9,75,27,-)
%?if(%mp, >, 1)<%xd(playmodes,%mp)|%xd(playmodes,1)>

# Shuffle Icon
%Vl(mainMenu,92,9,75,27,-)
%?if(%mp, >, 1)<%?ps<%xd(shuffle,1)|%xd(shuffle,2)>|%xd(shuffle,2)>>

# Repeat Icon
%Vl(mainMenu,168,9,75,27,-)
%?if(%mp, >, 1)<%?mm<%xd(repeat,5)|%xd(repeat,1)|%xd(repeat,2)|%xd(repeat,3)|%xd(repeat,4)>|%xd(repeat,5)>

# Hold Icon
%Vl(mainMenu,398,9,75,27,-)
%?mh<%xd(lock,1)|%xd(lock,2)>

# Battery Icon
%Vl(mainMenu,353,9,33,27,-)
%?bp<%xd(battery,7)|%?bl<%xd(battery,6)|%xd(battery,5)|%xd(battery,4)|%xd(battery,3)|%xd(battery,2)|%xd(battery,1)>>%?bp<%?bc<%?bl<%xd(battery,12)|%xd(battery,11)|%xd(battery,10)|%xd(battery,9)|%xd(battery,8)|%xd(battery,7)>|%?bl<%xd(battery,6)|%xd(battery,5)|%xd(battery,4)|%xd(battery,3)|%xd(battery,2)|%xd(battery,1)>>>

# Time
%Vl(mainMenu,330,53,143,30,4)
%ar%?cf<%cH|%cl>:%cM %?cf<| %cP >%Vs(invert)

# Date
%Vl(mainMenu,8,53,330,30,4)
%al %?cu<Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday>, %cb %cd%Vs(invert)

# Disk
%Vl(mainMenu,324,11,24,24,-)
%?lh<%t(0.1)%xd(disk,5);%t(0.1)%xd(disk,1);%t(0.1)%xd(disk,2);%t(0.1)%xd(disk,3);%t(0.1)%xd(disk,4)|%xd(disk,5)>

# Mini Album Art
%Vl(mainMenu,15,330,24,24,-)
%Cl(2,2,21,21,c,c)
%?if(%mp, >, 1)<%?C<%Cd|%xd(music_note)>>
%?if(%mp, >, 1)<%?C<%dr(0,0,24,2)>>
%?if(%mp, >, 1)<%?C<%dr(0,23,24,1)>>
%?if(%mp, >, 1)<%?C<%dr(0,2,2,21)>>
%?if(%mp, >, 1)<%?C<%dr(23,2,1,21)>>

# Now Playing
%Vl(mainMenu,45,332,428,24,3)
%?if(%mp, >, 1)<%al%s%?it<%it|%fn>%?ia< - %ia>>

## Quick Screen ##

# Clear Screen
%?if(%cs, =, 10)<%Vd(QuickScreen)%VI(QuickScreen)>

# Quick Screen Viewport
%Vi(QuickScreen,15,90,450,240,3)

## USB Screen ##

# USB Screen Viewport
%Vl(usbScreen,0,0,480,360,-)

# Time
%Vl(usbScreen,8,9,360,30,4)
%al%?cf<%cH|%cl>:%cM%?cf<| %cP>

# Battery Icon
%Vl(usbScreen,432,9,33,27,-)
%?bp<%xd(battery,7)|%?bl<%xd(battery,6)|%xd(battery,5)|%xd(battery,4)|%xd(battery,3)|%xd(battery,2)|%xd(battery,1)>>%?bp<%?bc<%?bl<%xd(battery,12)|%xd(battery,11)|%xd(battery,10)|%xd(battery,9)|%xd(battery,8)|%xd(battery,7)>|%?bl<%xd(battery,6)|%xd(battery,5)|%xd(battery,4)|%xd(battery,3)|%xd(battery,2)|%xd(battery,1)>>>

# Line
%Vl(usbScreen,8,45,465,3,-)
%dr(0,0,465,3)

# USB Text
%Vl(usbScreen,90,68,300,30,4)
%acUSB CONNECTED%Vs(invert)

# Eject Warning
%Vl(usbScreen,90,113,300,27,3)
%ac%t(1)! EJECT BEFORE DISCONNECTING !;%t(.1)%ac

# Battery (numerical)
%Vl(usbScreen,338,9,75,30,4)
%ar%bl%%

# USB Image
%Vl(usbScreen,98,165,285,174,-)
%xd(usb)