# Theme: ALLCAPS
# Version 1.0
# Last Update: 08/17/2026
# License: CC-BY-SA 3.0
# By: Monica G.
# By: rockbox-y1 (360p conversion)
# Description: All capital letters for the font and large text size for the title and artist. I merged the fonts Home Video by GGBOTNET and LanaPixel by eishiya using FontForge. Other than that, pretty simple theme! Code is based on my previous themes, specifically bunnyPod and minimal_RTCsync. All icons created by me.

# SBS File

# Disable Status Bar
%wd

# Disable Title
%?Lt<|>

# Preload Fonts
%Fl(6,07-HomeVideo-CJK.fnt)
%Fl(7,21-HomeVideo-CJK.fnt)

#Preload Images
%xl(playmodes,playmodes.bmp,0,0,9)
%xl(repeat,repeat_status.bmp,0,0,5)
%xl(shuffle,shuffle.bmp,0,0,2)
%xl(battery,battery.bmp,0,0,12)
%xl(disk,disk.bmp,0,0,5)
%xl(music_note,music_note.bmp,0,0)
%xl(usb,usb.bmp,0,0)

# Display Viewports
%?if(%cs, =, 21)<%VI(clearScreen)%Vd(usbScreen)|%Vd(mainMenu)<%VI(mainMenu)%Vd(mainMenu)>>

# Clear Screen
%Vi(clearScreen,0,0,2,2,-)

## Main Menu ##

# Main Menu UI Viewport
%Vi(mainMenu,8,68,465,255,7)

# Line
%Vl(mainMenu,8,54,465,2,-)
%dr(0,0,465,3)

# Play/Pause Icons
%Vl(mainMenu,15,11,41,33,-)
%?if(%mp, >, 1)<%xd(playmodes,%mp)|%xd(playmodes,1)>

# Shuffle Icon
%Vl(mainMenu,57,11,41,33,-)
%?if(%mp, >, 1)<%?ps<%xd(shuffle,1)|%xd(shuffle,2)>|>

# Repeat Icon
%Vl(mainMenu,105,11,41,33,-)
%?if(%mp, >, 1)<%?mm<%xd(repeat,5)|%xd(repeat,1)|%xd(repeat,2)|%xd(repeat,3)|%xd(repeat,4)>|>

# Hold
%Vl(mainMenu,330,18,60,23,6)
%ac%?mh<HOLD%Vs(invert)|>

# Battery Icon
%Vl(mainMenu,398,15,33,27,-)
%?bp<%xd(battery,7)|%?bl<%xd(battery,6)|%xd(battery,5)|%xd(battery,4)|%xd(battery,3)|%xd(battery,2)|%xd(battery,1)>>%?bp<%?bc<%?bl<%xd(battery,12)|%xd(battery,11)|%xd(battery,10)|%xd(battery,9)|%xd(battery,8)|%xd(battery,7)>|%?bl<%xd(battery,6)|%xd(battery,5)|%xd(battery,4)|%xd(battery,3)|%xd(battery,2)|%xd(battery,1)>>>

# Disk
%Vl(mainMenu,435,15,30,30,-)
%?lh<%t(0.1)%xd(disk,5);%t(0.1)%xd(disk,1);%t(0.1)%xd(disk,2);%t(0.1)%xd(disk,3);%t(0.1)%xd(disk,4)|%xd(disk,5)>

%Vl(mainMenu,8,324,24,24,-)
%Cl(1,2,21,21,c,c)
%?if(%mp, >, 1)<%?C<%Cd|%xd(music_note)>|>
%?if(%mp, >, 1)<%?C<%dr(0,0,24,2)>|>
%?if(%mp, >, 1)<%?C<%dr(0,23,24,1)>|>
%?if(%mp, >, 1)<%?C<%dr(0,2,1,21)>|>
%?if(%mp, >, 1)<%?C<%dr(22,2,2,21)>|>

# Now Playing
%Vl(mainMenu,38,330,435,24,6)
%?if(%mp, >, 1)<%s%?it<%it|%fn>%?ia< - %ia>|>

## Quick Screen ##

# Clear Screen
%?if(%cs, =, 10)<%Vd(QuickScreen)%VI(QuickScreen)>

# Quick Screen Viewport
%Vi(QuickScreen,15,68,450,255,6)

## USB Screen ##

# USB Screen Viewport
%Vl(usbScreen,0,0,480,360,-)

# Time / Battery (numerical)
%Vl(usbScreen,15,23,360,37,6)
%al%?cf<%al%cH|%cl>:%cM%?cf<| %cP>

# Battery Level
%Vl(usbScreen,375,23,45,18,6)
%ar%bl%%

# Battery
%Vl(usbScreen,435,15,33,27,-)
%?bp<%xd(battery,7)|%?bl<%xd(battery,6)|%xd(battery,5)|%xd(battery,4)|%xd(battery,3)|%xd(battery,2)|%xd(battery,1)>>%?bp<%?bc<%?bl<%xd(battery,12)|%xd(battery,11)|%xd(battery,10)|%xd(battery,9)|%xd(battery,8)|%xd(battery,7)>|%?bl<%xd(battery,6)|%xd(battery,5)|%xd(battery,4)|%xd(battery,3)|%xd(battery,2)|%xd(battery,1)>>>

# Line
%Vl(usbScreen,8,54,465,3,-)
%dr(0,0,465,3)

# USB Text
%Vl(usbScreen,15,75,450,38,7)
%acUSB CONNECTED%Vs(invert)

# Eject Warning
%Vl(usbScreen,15,113,450,21,6)
%ac%t(1)! EJECT BEFORE DISCONNECTING !;%t(.1)%ac

%Vl(usbScreen,155,135,171,171,-)
%xd(usb)