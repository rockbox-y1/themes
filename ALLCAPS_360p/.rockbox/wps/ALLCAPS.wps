# Theme: ALLCAPS
# Version 1.0
# Last Update: 08/17/2026
# License: CC-BY-SA 3.0
# By: Monica G.
# By: rockbox-y1 (360p conversion)
# Description: All capital letters for the font and large text size for the title and artist. I merged the fonts Home Video by GGBOTNET and LanaPixel by eishiya using FontForge. Other than that, pretty simple theme! Code is based on my previous themes, specifically bunnyPod and minimal_RTCsync. All icons created by me.

## WPS File ##

#Hide The Status Bar
%wd

# Preload Fonts
%Fl(6,7-HomeVideo-CJK.fnt)
%Fl(7,21-HomeVideo-CJK.fnt)
%Fl(8,28-HomeVideo-CJK.fnt)
%Fl(9,42-HomeVideo-CJK.fnt)

# Preload Images
%xl(playmodes,playmodes.bmp,0,0,9)
%xl(repeat,repeat_status.bmp,0,0,5)
%xl(shuffle,shuffle.bmp,0,0,2)
%xl(battery,battery.bmp,0,0,12)
%xl(PB,pb.bmp,0,0)
%xl(PBB,pb_back.bmp,0,0)
%xl(VB,vb.bmp,0,0)
%xl(VBB,vb_back.bmp,0,0)
%xl(no_album,no_album.bmp,2,2)
%xl(disk,disk.bmp,0,0,5)
%xl(PS,ps.bmp,0,0)

## Main Display ##
%Vd(mainDisplay)

# Clear Screen
%Vl(mainDisplay,0,0,480,360,-)

# Hold
%Vl(mainDisplay,296,8,105,33,7)
%ac%?mh<HOLD%Vs(invert)|>

# Time
%Vl(mainDisplay,138,8,150,33,7)
%ac%?cf<%cH|%cl>:%cM%?cf<| %cP>%Vs(invert)

# Battery Icon
%Vl(mainDisplay,405,8,33,27,-)
%?bp<%xd(battery,7)|%?bl<%xd(battery,6)|%xd(battery,5)|%xd(battery,4)|%xd(battery,3)|%xd(battery,2)|%xd(battery,1)>>%?bp<%?bc<%?bl<%xd(battery,12)|%xd(battery,11)|%xd(battery,10)|%xd(battery,9)|%xd(battery,8)|%xd(battery,7)>|%?bl<%xd(battery,6)|%xd(battery,5)|%xd(battery,4)|%xd(battery,3)|%xd(battery,2)|%xd(battery,1)>>>

# Disk
%Vl(mainDisplay,444,8,29,25,-)
%?lh<%t(0.1)%xd(disk,5);%t(0.1)%xd(disk,1);%t(0.1)%xd(disk,2);%t(0.1)%xd(disk,3);%t(0.1)%xd(disk,4)|%xd(disk,5)>

# Playlist Number
%Vl(mainDisplay,308,50,165,33,7)
%ar%pp/%pe

# Play/Pause Icons
%Vl(mainDisplay,138,47,38,33,-)
%?if(%mp, >, 1)<%xd(playmodes,%mp)|>

# Shuffle Icon
%Vl(mainDisplay,185,47,40,33,-)
%?ps<%xd(shuffle,1)|%xd(shuffle,2)>

# Repeat Icon
%Vl(mainDisplay,240,47,41,33,-)
%?mm<%xd(repeat,5)|%xd(repeat,1)|%xd(repeat,2)|%xd(repeat,3)|%xd(repeat,4)>

# Volume Bar
%Vl(mainDisplay,138,102,240,29,-)
%pv(0,0,240,29,VBB,backdrop,VB)

# Volume Text
%Vl(mainDisplay,137,87,105,15,6)
%al%?if(%pv, =, -90)<MUTE|VOLUME>
%Vl(mainDisplay,386,102,87,33,7)
%ac%?if(%pv, >, 0)<+|>%pvdB

# Time Elapsed
%Vl(mainDisplay,8,335,60,15,6)
%ac%pc%Vs(invert)

# Track Progress Bar
%Vl(mainDisplay,75,330,330,23,-)%Vf(-)%Vb(-)
%pb(0,0,-,23,PBB,backdrop,PB,slider,PS)

# Time Remaining
%Vl(mainDisplay,413,335,60,15,6)
%ac-%pr%Vs(invert)

# Play Screen Album Art
%Vl(mainDisplay,8,8,123,123,-)
%Cl(1,1,120,120,c,c)
%?C<%Cd|%xd(no_album)>
%dr(0,0,123,1)
%dr(0,121,123,2)
%dr(0,1,1,120)
%dr(121,1,2,120)

# Track Title
%Vl(mainDisplay,8,147,465,57,9)
%al%s%?it<%s%it|%fn>

# Artist
%Vl(mainDisplay,8,206,465,39,8)
%al%s%?ia<%ia>

# Album
%Vl(mainDisplay,8,252,465,33,7)
%al%s%?id<%id>

# File Info
%Vl(mainDisplay,8,285,465,15,6)
%al%?it<%?iy<%ss(0,4,%iy)|>|> | %fc | %fb kbps | %fk kHz