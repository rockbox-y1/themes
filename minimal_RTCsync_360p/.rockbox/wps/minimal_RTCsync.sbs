# Theme: minimal_RTCsync
# Version 1.0
# Last Update: 05/15/2026
# License: CC-BY-SA 3.0
# By: Monica G.
# By: rockbox-y1 (360p conversion)
# Description: Minimalist but modern theme. All pixel art is by me. The picture on the menu changes according to the time of day (changes at 6 AM, 12 PM, and 6 PM). 
# Code based on: BACKBONE and Pixel Computer by me! which are based on SNARTY by Simon Anden and BONES by Chuck Largo!
# Icons & viewers from my 1ST_GEN_REMIX theme with some small changes. Hold screen does not show album art.
# The San Francisco font is owned by Apple Inc. and this theme does not claim any ownership over the font.

# SBS File

# Disable Status Bar
%wd

# Disable Title
%?Lt<|>

# Preload Fonts
%Fl(6,24-SFProText-SemiboldItalic.fnt)
%Fl(7,30-SFProText-Regular.fnt)
%Fl(8,30-SFProText-SemiboldItalic.fnt)
%Fl(9,39-SFProText-Bold.fnt)

#Preload Images
%xl(rtc_sbs,rtc_sbs.bmp,0,0,4)
%xl(playmodes,playmodes.bmp,0,0,9)
%xl(repeat,repeat_status.bmp,0,0,5)
%xl(shuffle,shuffle.bmp,0,0,2)
%xl(battery,battery.bmp,0,0,12)
%xl(disk,disk.bmp,0,0)
%xl(music_note,music_note.bmp,0,0)
%xl(rtc_usb,rtc_usb.bmp,0,0)

# Display Viewports
%?if(%cs, =, 21)<%VI(clearScreen)%Vd(usbScreen)|%Vd(mainMenu)<%VI(mainMenu)%Vd(mainMenu)>>

# Clear Screen
%Vi(clearScreen,0,0,2,2,-)

## Main Menu ##

# Main Menu UI Viewport
%Vi(mainMenu,8,68,315,255,7)

# SBS Icon
%Vl(mainMenu,330,146,143,210,-)
%?if(%cH, <, 0)<%xd(rtc_sbs,1)|%?if(%cH, <, 6)<%xd(rtc_sbs,2)|%?if(%cH, <, 12)<%xd(rtc_sbs,3)|%?if(%cH, <, 18)<%xd(rtc_sbs,4)|%xd(rtc_sbs,1)>>>>

# Play/Pause Icons
%Vl(mainMenu,15,11,33,33,-)
%?if(%mp, >, 1)<%xd(playmodes,%mp)|>

# Shuffle Icon
%Vl(mainMenu,53,9,37,33,-)
%?if(%mp, >, 1)<%?ps<%xd(shuffle,1)|%xd(shuffle,2)>|>

# Repeat Icon
%Vl(mainMenu,98,11,37,33,-)
%?if(%mp, >, 1)<%?mm<%xd(repeat,5)|%xd(repeat,1)|%xd(repeat,2)|%xd(repeat,3)|%xd(repeat,4)>|>

# Hold Status
%Vl(mainMenu,180,14,135,37,8)
%?mh<%acHOLD|>

# Battery
%Vl(mainMenu,390,11,81,34,-)
%?bp<%xd(battery,7)|%?bl<%xd(battery,6)|%xd(battery,5)|%xd(battery,4)|%xd(battery,3)|%xd(battery,2)|%xd(battery,1)>>%?bp<%?bc<%?bl<%xd(battery,12)|%xd(battery,11)|%xd(battery,10)|%xd(battery,9)|%xd(battery,8)|%xd(battery,7)>|%?bl<%xd(battery,6)|%xd(battery,5)|%xd(battery,4)|%xd(battery,3)|%xd(battery,2)|%xd(battery,1)>>>

# Time
%Vl(mainMenu,330,99,143,30,6)
%ac%?cf<%cH|%cl>:%cM%?cf<| %cP>%Vs(invert)

# Disk
%Vl(mainMenu,353,14,25,27,-)
%?lh<%t(0.5)%xd(disk);%t(0.5)|>

# Line
%Vl(mainMenu,8,54,465,3,-)
%dr(0,0,465,3)

%Vl(mainMenu,8,324,24,24,-)
%Cl(1,2,21,21,c,c)
%?if(%mp, >, 1)<%?C<%Cd|%xd(music_note)>|>
%?if(%mp, >, 1)<%?C<%dr(0,0,24,2)>|>
%?if(%mp, >, 1)<%?C<%dr(0,23,24,1)>|>
%?if(%mp, >, 1)<%?C<%dr(0,2,1,21)>|>
%?if(%mp, >, 1)<%?C<%dr(22,2,2,21)>|>

# Now Playing
%Vl(mainMenu,38,324,435,24,6)
%?if(%mp, >, 1)<%s%?it<%it|%fn>%?ia< - %ia>|>

## Quick Screen ##

# Clear Screen
%?if(%cs, =, 10)<%Vd(QuickScreen)%VI(QuickScreen)>

# Quick Screen Viewport
%Vi(QuickScreen,15,60,300,263,6)

## USB Screen ##

# USB Screen Viewport
%Vl(usbScreen,0,0,480,360,-)

# Time / Battery (numerical)
%Vl(usbScreen,15,15,360,38,6)
%al%?cf<%al%cH|%cl>:%cM%?cf<| %cP> %ar%bl%%

# Battery
%Vl(usbScreen,390,11,81,34,-)
%?bp<%xd(battery,7)|%?bl<%xd(battery,6)|%xd(battery,5)|%xd(battery,4)|%xd(battery,3)|%xd(battery,2)|%xd(battery,1)>>%?bp<%?bc<%?bl<%xd(battery,12)|%xd(battery,11)|%xd(battery,10)|%xd(battery,9)|%xd(battery,8)|%xd(battery,7)>|%?bl<%xd(battery,6)|%xd(battery,5)|%xd(battery,4)|%xd(battery,3)|%xd(battery,2)|%xd(battery,1)>>>

# Line
%Vl(usbScreen,8,54,465,3,-)
%dr(0,0,465,3)

%Vl(usbScreen,128,75,225,188,-)
%xd(rtc_usb)

# USB Text
%Vl(usbScreen,15,263,450,30,8)
%acUSB CONNECTED%Vs(invert)

# Eject Warning
%Vl(usbScreen,15,300,450,30,6)
%ac! EJECT BEFORE DISCONNECTING !