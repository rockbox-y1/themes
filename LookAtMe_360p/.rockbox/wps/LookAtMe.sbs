# LookAtMe by Serge Fnstll
# 360p conversion by rockbox-y1
# 2026-06-23 v1.0

# Disable Status Bar
%wd

# Preload Font
%Fl(3,48-SF-Pro-Display-Black.fnt)
%Fl(4,24-SFPro-Bold-CJK.fnt)
%Fl(5,24-SFPro-Regular-CJK.fnt)

# Preload Images
%xl(battery,battery.bmp,0,0,12)
%xl(battery_charging,battery_charging.bmp,0,0,12)
%xl(usb,usb.bmp,0,0)
%xl(a,usb_animation.bmp,0,0,8)
%xl(L,lock.bmp)
%xl(menuback,menu_bg.bmp)
%xl(f,rf menu.bmp,0,0)
%xl(star,nocover2.bmp,0,0)
%xl(prog,prog.bmp,0,0)
%xl(progbg,progbg.bmp,0,0)
%Cl(0,-63,480,480,c,c)

# Viewport Rules
%?if(%cs, =, 21)<%Vd(usb_img)%Vd(usb_txt)%VI(usb_hide)|%Vd(blackout)%Vd(progress)%Vd(rfmenu)%?bc<%Vd(battCharging)|%?if(%bl,>=,15)<%Vd(batt)|%Vd(lowBatt)>>%?if(%cs, =, 10)<%Vd(qsTitle)%?C<%Vd(noStar)|%Vd(withStar)>|%VI(menu)%Vd(info)%?C<%Vd(noStar)|%Vd(withStar)>>>

# Display Viewports

# USB cleaner
%Vi(usb_hide,0,0,2,2,-)

# With Album Art
%Vl(noStar,0,0,480,105,-)%VB
%Cd

# No Album Art
%Vl(withStar,0,0,480,105,-)%VB
%xd(star)

# Transparent foreground status
%Vl(rfmenu,0,0,480,105,-)
%?if(%mp, =, 3)<%xd(f)|>

# Menu
%Vi(menu,15,146,450,207,-)%Vf(c3c3c3)
%Lb(menuRow,146,23)

# Menu row renderer
%Vl(menuRow,0,0,450,35,5)
%?Lc<%Vf(e3e3e3)|%Vf(737373)>
%?if(%LT,=,%Sx(Now Playing))<%sNow Playing: %?it<%it|%fn>|%?if(%St(scroll speed),=,1)<|%s>%LT>

# Menu Title
%Vl(info,15,116,378,24,4)
%Vf(e3e3e3)
%al%s%?cs<Main Menu|%?Lt<%Lt>>

# Hold
%Vl(info,405,120,12,15,-)
%Vf(ff7508)
%?mh<%xd(L)>

# Quick Screen title viewport
%Vl(qsTitle,15,116,152,24,4)
%Vf(e3e3e3)
%alQuick Screen

# Battery viewports
%Vl(batt,429,119,36,19,-)
%?if(%bl, =, 100)<%xd(battery,11)|%?if(%bl,>=,90)<%xd(battery,10)|%?if(%bl,>=,80)<%xd(battery,9)|%?if(%bl,>=,70)<%xd(battery,8)|%?if(%bl,>=,60)<%xd(battery,7)|%?if(%bl,>=,50)<%xd(battery,6)|%?if(%bl,>=,40)<%xd(battery,5)|%?if(%bl,>=,30)<%xd(battery,4)|%?if(%bl,>=,20)<%xd(battery,3)|%?if(%bl,>=,10)<%xd(battery,2)|%xd(battery,1)>>>>>>>>>>

%Vl(lowBatt,429,119,36,19,-)
%t(1)%?if(%bl,>=,10)<%xd(battery,1)|%xd(battery,1)>;%t(1)%xd(battery,2)

%Vl(battCharging,429,119,36,19,-)
%?if(%bl, =, 100)<%xd(battery_charging,11)|%?if(%bl,>=,90)<%xd(battery_charging,10)|%?if(%bl,>=,80)<%xd(battery_charging,9)|%?if(%bl,>=,70)<%xd(battery_charging,8)|%?if(%bl,>=,60)<%xd(battery_charging,7)|%?if(%bl,>=,50)<%xd(battery_charging,6)|%?if(%bl,>=,40)<%xd(battery_charging,5)|%?if(%bl,>=,30)<%xd(battery_charging,4)|%?if(%bl,>=,20)<%xd(battery_charging,3)|%?if(%bl,>=,10)<%xd(battery_charging,2)|%xd(battery_charging,1)>>>>>>>>>>

# Progress Bar
%Vl(progress,0,354,480,6,-)%Vf(-)
%pb(0,0,480,6,prog,backdrop,progbg)

# Clear screen 
%Vl(blackout,0,105,480,255,-)%VB
%xd(menuback)

# USB Background Layer
%Vl(usb_img,0,0,480,360,-)%VB
%xd(usb)

# USB Animation Viewport
%Vi(usb_anim,14,74,18,18,-)
%?if(%cs, =, 21)<%t(0.1)%xd(a,1);%t(0.1)%xd(a,2);%t(0.1)%xd(a,3);%t(0.1)%xd(a,4);%t(0.1)%xd(a,5);%t(0.1)%xd(a,6);%t(0.1)%xd(a,7);%t(0.1)%xd(a,8)>

# USB Text Layer
%Vl(usb_txt,30,120,420,53,3)%Vf(e3e3e3)
%acUSB CONNECTED

%Vl(usb_txt,30,165,420,38,5)
%Vf(737373)
%acEject Before Disconnecting
