# Disable Status Bar
%wd

# Disable Title
#%?Lt<|>

# Preload Font
%Fl(2,20-FiraSans-Regular.fnt)
%Fl(3,32-FiraSansCompressed-Medium.fnt)

# Preload Images
%xl(battery,battery.bmp,0,0,12)
%xl(playmodes,playmodes.bmp,0,0,9)
%xl(usb,usb.bmp,0,0)
%xl(L,lock.bmp)
%xl(star,nocover.bmp,240,0)
%xl(albumArtRefresher,empty.bmp,0,0)

# Album Art Position Selector
%?and(%if(%mp, >, 1),%C)<%?px<%Vd(prog0)|%Vd(prog1)|%Vd(prog2)|%Vd(prog3)|%Vd(prog4)|%Vd(prog5)|%Vd(prog6)|%Vd(prog7)|%Vd(prog8)|%Vd(prog9)|%Vd(prog10)|%Vd(prog11)|%Vd(prog12)|%Vd(prog13)|%Vd(prog14)|%Vd(prog15)|%Vd(prog16)|%Vd(prog17)|%Vd(prog18)|%Vd(prog19)|%Vd(prog20)|%Vd(prog21)|%Vd(prog22)|%Vd(prog23)|%Vd(prog24)|%Vd(prog25)|%Vd(prog26)|%Vd(prog27)|%Vd(prog28)|%Vd(prog29)|%Vd(prog30)|%Vd(prog31)|%Vd(prog32)|%Vd(prog33)|%Vd(prog34)|%Vd(prog35)|%Vd(prog36)|%Vd(prog37)|%Vd(prog38)|%Vd(prog39)|%Vd(prog40)>|%Vd(noAlbumArt)>

# Album Art Preload
%Cl(0,0,360,360,c,c)
%?if(%cs, !=, 21)<%?C<%Vd(noStar)|%Vd(withStar)>>

#__USB screen
%?if(%cs, =, 21)<%VI(clearScreen)%Vd(usb)|%VI(menu)%Vd(info)%Vd(batt)>

#__Clear Screen
%Vi(clearScreen,0,0,2,2,-)

