# Disable Status Bar
%wd

# Preload Fonts
%Fl(3,32-FiraSansCompressed-Medium.fnt)
%Fl(5,20-FiraSans-Regular.fnt)
%Fl(7,32-FiraSansCompressed-Medium.fnt)
%Fl(8,72-FiraSans-Ultra.fnt)

# Preload Images
%xl(battery,battery.bmp,0,0,12)
%xl(playmodes,playmodes.bmp,0,0,9)
%xl(volbg,volbg.bmp,0,0)
%xl(vol,vol.bmp,0,0)
%xl(R,repeat_status.bmp,4)
%xl(S,shuffle_status.bmp)
%xl(L,lock.bmp)
%xl(star,nocover.bmp)
%xl(albumArtRefresher,empty.bmp,0,0)

# Album Art Position Selector
%?mh<|%?C<%?px<%Vd(prog0)|%Vd(prog1)|%Vd(prog2)|%Vd(prog3)|%Vd(prog4)|%Vd(prog5)|%Vd(prog6)|%Vd(prog7)|%Vd(prog8)|%Vd(prog9)|%Vd(prog10)|%Vd(prog11)|%Vd(prog12)|%Vd(prog13)|%Vd(prog14)|%Vd(prog15)|%Vd(prog16)|%Vd(prog17)|%Vd(prog18)|%Vd(prog19)|%Vd(prog20)|%Vd(prog21)|%Vd(prog22)|%Vd(prog23)|%Vd(prog24)|%Vd(prog25)|%Vd(prog26)|%Vd(prog27)|%Vd(prog28)|%Vd(prog29)|%Vd(prog30)|%Vd(prog31)|%Vd(prog32)|%Vd(prog33)|%Vd(prog34)|%Vd(prog35)|%Vd(prog36)|%Vd(prog37)|%Vd(prog38)|%Vd(prog39)|%Vd(prog40)>|%Vd(noAlbumArt)>>

# Display Viewports
%Vd(main)
%?mh<%Vd(lockscreen)|%Vd(metadata)%?mv(3)<%Vd(volume)|%Vd(prog)>%?ps<%Vd(repeatModeDark)|%?mm<%Vd(noRepeatDark)|%Vd(repeatModeDark)>>>
