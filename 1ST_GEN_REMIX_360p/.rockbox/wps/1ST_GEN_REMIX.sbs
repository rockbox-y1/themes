# Theme: 1ST_GEN_REMIX
# Version 1.0
# Last Update: 01/26/2026
# License: CC-BY-SA 3.0
# By: Monica G.
# By: rockbox-y1 (360p conversion)
# Description: Theme based on the iPod classic 1st generation's UI with some added features.
# Icons & viewers based on Susan Kare's classic Macintosh icons.
# Code based on: BACKBONE and Pixel Computer by me! which are based on SNARTY by Simon Anden and BONES by Chuck Largo!
# Hold screen is stripped back from the WPS to make room for album art.

# SBS File

# Disable Status Bar
%wd

# Disable Title
%?Lt<|>

# Preload Fonts
%Fl(2,19-Nimbus.fnt)
%Fl(3,29-ChicagoFLF.fnt)

#Preload Images
%xl(happy_mac,happy_mac.bmp,0,0)
%xl(sad_mac,sad_mac.bmp,0,0)
%xl(playmodes,playmodes.bmp,0,0,9)
%xl(repeat,repeat_status.bmp,0,0,5)
%xl(shuffle,shuffle.bmp,0,0,2)
%xl(battery,battery.bmp,0,0,12)
%xl(disk,disk.bmp,0,0)

# Display Viewports
%?if(%cs, =, 21)<%VI(clearScreen)%Vd(usbScreen)|%Vd(mainMenu)<%VI(mainMenu)%Vd(mainMenu)>>

# Clear Screen
%Vi(clearScreen,0,0,2,2,-)

## Main Menu ##

# Main Menu UI Viewport
%Vi(mainMenu,8,68,315,255,3)

# Mac Icon
%Vl(mainMenu,330,113,143,180,-)
%xd(happy_mac)

# Play/Pause Icons
%Vl(mainMenu,15,11,33,33,-)
%?if(%mp, >, 1)<%xd(playmodes,%mp)|>

# Shuffle Icon
%Vl(mainMenu,53,9,37,33,-)
%?if(%mp, >, 1)<%?ps<%xd(shuffle,1)|%xd(shuffle,2)>|>

# Repeat Icon
%Vl(mainMenu,98,11,37,33,-)
%?if(%mp, >, 1)<%?mm<%xd(repeat,5)|%xd(repeat,1)|%xd(repeat,2)|%xd(repeat,3)|%xd(repeat,4)>|>

# Hold / Device
%Vl(mainMenu,180,14,135,37,3)
%?mh<%acHOLD|%aciPod>

# Battery
%Vl(mainMenu,390,11,81,34,2)
%?bp<%xd(battery,7)|%?bl<%xd(battery,6)|%xd(battery,5)|%xd(battery,4)|%xd(battery,3)|%xd(battery,2)|%xd(battery,1)>>|%?bp<%?bc<%?bl<%xd(battery,12)|%xd(battery,11)|%xd(battery,10)|%xd(battery,9)|%xd(battery,8)>|%xd(battery,7)>|%?bl<%xd(battery,6)|%xd(battery,5)|%xd(battery,4)|%xd(battery,3)|%xd(battery,2)|%xd(battery,1)>>>

# Time
%Vl(mainMenu,330,68,143,37,3)
%ac%?cf<%cH|%cl>:%cM%?cf<| %cP>%Vs(invert)

# Disk
%Vl(mainMenu,353,14,25,27,-)
%?lh<%t(0.5)%xd(disk);%t(0.5)|>

# Line
%Vl(mainMenu,8,54,465,3,-)
%dr(0,0,465,3)

# Now Playing
%Vl(mainMenu,8,327,465,23,2)
%ac%?mp<|%s%?it<%it|%fn>%?ia< - %ia>|>

## Quick Screen ##

# Clear Screen
%?if(%cs, =, 10)<%Vd(QuickScreen)%VI(QuickScreen)>

# Quick Screen Viewport
%Vi(QuickScreen,15,60,300,267,2)

## USB Screen ##

# USB Screen Viewport
%Vl(usbScreen,0,0,480,360,-)

# Time / Battery (numerical)
%Vl(usbScreen,60,15,360,38,3)
%t(10)%ac%?cf<%ac%cH|%cl>:%cM%?cf<| %cP>;%t(10)%acBattery: %bl%%

# Battery
%Vl(usbScreen,390,11,81,34,2)
%?bp<%xd(battery,7)|%?bl<%xd(battery,6)|%xd(battery,5)|%xd(battery,4)|%xd(battery,3)|%xd(battery,2)|%xd(battery,1)>>|%?bp<%?bc<%?bl<%xd(battery,12)|%xd(battery,11)|%xd(battery,10)|%xd(battery,9)|%xd(battery,8)>|%xd(battery,7)>|%?bl<%xd(battery,6)|%xd(battery,5)|%xd(battery,4)|%xd(battery,3)|%xd(battery,2)|%xd(battery,1)>>>

# Line
%Vl(usbScreen,8,54,465,3,-)
%dr(0,0,465,3)

# USB Mac Icon
%Vl(usbScreen,330,113,143,180,-)
%xd(sad_mac)

# USB Text
%Vl(usbScreen,8,143,315,40,3)
%acUSB CONNECTED%Vs(invert)

# USB Eject Box
%Vl(usbScreen,8,195,315,41,-)
%dr(0,0,315,2)%dr(0,0,1,39)%dr(313,0,2,39)%dr(0,39,315,2)

# Eject Warning
%Vl(usbScreen,9,207,308,27,2)
%ac%t(1)! EJECT BEFORE DISCONNECTING !;%t(.1)%ac