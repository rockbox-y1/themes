
# Theme: Pixel Computer
# Version 1.0
# Last Update: 06Dec25
# License: CC-BY-SA 3.0
# By: Monica G.
# By: rockbox-y1 (360p conversion)
# Description: Simple pixel art of an old PC! Changing the background color changes some elements in the WPS, but kept all other menus/screens grey-scale.
# Code based on OneBit_OLED by Jihoon Kim and SNARTY by Simon Anden!
# Icons/elements also altered from OneBit_OLED by Jihoon Kim and SNARTY by Simon Anden!

# Disable Status Bar
%wd

# Backdrop Image
%xl(pc_wps,pc_wps.bmp,0,0)

# Clear Backdrop
%V(0,0,-,-,-)%VB
%xd(pc_wps)
%V(0,0,-,-,-)

# Preload Fonts
%Fl(2,14-Terminus.fnt)
%Fl(3,28-Terminus.fnt)
%Fl(4,22-Terminus.fnt)

# Preload Images
%xl(battery,battery.bmp,0,0,12)
%xl(playmodes_wps,playmodes_wps.bmp,0,0,9)
%xl(vb_back,vb_back.bmp,0,0)
%xl(vb,vb.bmp,0,0)
%xl(pb_back,pb_back.bmp,0,0)
%xl(pb,pb.bmp,0,0)
%xl(R,repeat_status_wps.bmp,0,0,5)
%xl(S,shuffle_wps.bmp,0,0,2)
%xl(lock,lock.bmp,0,0,2)
%xl(X,seeking_icon.bmp,0,0,2)
%xl(slider,slider.bmp,0,0)
%xl(L,lossless.bmp,0,0)

# Album Art
%Cl(0,0,141,141,c,c)
%?and(%C,%if(%St(volume display), =, graphic))<%Vd(albumArt)>
%Vl(albumArt,321,51,150,150,-)
%Cd


## Icons ##

#Hold Status
%V(386,2,16,21,-)
%?mh<%xd(lock,1)|%xd(lock,2)>
%V(324,0,60,20,2)%Vf(ffffff)
%?mh<%acLOCKED|>

# Storage Access
%V(308,2,18,18,-)
%?lh<%t(0.1)%xd(X,1);%t(0.1)%xd(X,2)|>

# Playback Icons
%V(8,30,33,33,-)
%?if(%mp, >, 1)<%xd(playmodes_wps,%mp)|>

# Repeat Icon
%V(45,30,33,33,-)
%?mm<%xd(R,1)|%xd(R,2)|%xd(R,3)|%xd(R,4)|%xd(R,5)>

# Shuffle Icon
%V(83,30,33,33,-)
%?ps<%xd(S,2)|%xd(S,1)>

# Battery viewport selector (flash when low, animates when charging)
%?bc<%Vd(battCharging)|%?if(%bl,>=,15)<%Vd(batt)|%Vd(lowBatt)>>

# Battery (graphical)
%Vl(batt,443,5,34,15,-)
%Vf(-)
%?bl<%xd(battery,1)|%xd(battery,2)|%xd(battery,3)|%xd(battery,4)|%xd(battery,5)|%xd(battery,6)|%xd(battery,7)|%xd(battery,8)|%xd(battery,9)|%xd(battery,10)|%xd(battery,11)>

%Vl(lowBatt,443,5,34,15,-)
%Vf(-)
%t(1)%?if(%bl,>=,10)<%xd(battery,2)|%xd(battery,1)>;%t(1)%xd(battery,12)

%Vl(battCharging,443,5,34,15,-)
%Vf(-)
%t(0.1)%?bl<%xd(battery,1)|%xd(battery,2)|%xd(battery,3)|%xd(battery,4)|%xd(battery,5)|%xd(battery,6)|%xd(battery,7)|%xd(battery,8)|%xd(battery,9)|%xd(battery,10)|%xd(battery,11)>;%t(0.1)%?bl<%xd(battery,4)|%xd(battery,5)|%xd(battery,6)|%xd(battery,7)|%xd(battery,8)|%xd(battery,9)|%xd(battery,10)|%xd(battery,11)>;%t(0.1)%?bl<%xd(battery,8)|%xd(battery,9)|%xd(battery,10)|%xd(battery,11)>;%t(1)%xd(battery,11)

# Clock
%V(8,0,60,20,2)%Vf(ffffff)
%al%?cf<%cH|%cl>:%cM%?cf<| %cP>

# Battery (numerical)
%V(399,5,41,20,2)%Vf(ffffff)
%ar%bl%%

# Volume Level Text
%V(242,26,45,20,2)%Vf(ffffff)
%ar%?if(%pv, >, 0)<+|>%pvdB

%V(135,26,60,20,2)%Vf(ffffff)
%alVOLUME

#__Volume Bar
%V(135,44,150,27,-)
%pv(0,0,150,27,vb,pc_wps,vb_back)

# Progress Bar
%V(53,351,375,5,0)
%pb(0,0,375,5,pb,pc_wps,pb_back)

# Song Current Time
%V(3,345,48,15,2)%Vf(ffffff)
%ac%pc

# Song Remaining Time
%V(426,345,48,15,2)%Vf(ffffff)
%ac%pt

## Content ##

# Song Title
%V(15,117,270,45,4)%Vf(ffffff)
%al%s%?it<%s%it|%fn>

# Album
%V(15,90,270,27,3)%Vf(ffffff)
%al%s%?id<%id|Unknown Album>

# Artist
%V(15,165,270,27,3)%Vf(ffffff)
%al%s%?ia<%ia>

# Track Details
%V(15,195,270,23,2)%Vf(ffffff)
%al%?fc<MP1|MP2|MP3|AIFF|WAV|VORBIS|FLAC|MPC|AC3|WAVPACK|ALAC|AAC|SHORTEN|SID|ADX|NSF|SPEEX|SPC|APE|WMA|WMAPRO|MOD|SAP|COOK|AAC|AC3|ATRAC3|CMC|CM3|CMR|CMS|DMC|DLT|MPT|MPD|RMT|TMC|TM8|TM2|ATRAC3|SMAF|AU|VOX|WAVE64|TRUEAUDIO|WMAVOICE|MUSEPACK|AAC-HE|AY|VTX|GBS|HES|SGC|VGM|KSS|OPUS|AAC|UNKNOWN?> %?fv<~>%fbkbps // %?iy<%iy|>

%?or(%if(%fc, =, 4),%if(%fc, =, 5),%if(%fc, =, 7),%if(%fc, =, 11),%if(%fc, =, 13))<%Vd(lossless)>
%Vl(lossless,15,227,102,24,-)
%xd(L)

# Playlist Number
%V(135,2,150,18,2)%Vf(808080)
%?if(%pp, =, %pe)<%pp %Sx(of) %pe|%aL%pp %Sx(of) %pe|%aL%pp %Sx(of) %pe|%aL%pp %Sx(of) %pe|%aL%pp %Sx(of) %pe>

# Next track
%V(128,263,90,22,2)%Vf(C3C3C3)
%ar%Sx(Next Track:)
%V(15,285,195,23,2)%Vf(C3C3C3)
%s%ar%?It<%It|%Fn>
%V(15,308,180,22,2)%Vf(C3C3C3)
%s%ar%?Ia<%Ia>